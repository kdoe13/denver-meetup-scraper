{
  "manifest_version": 3,
  "name": "UWH Attendance Scraper",
  "version": "2.0",
  "description": "Scrape UWH meetup attendees and send to Django API",
  "action": {
    "default_popup": "popup_enhanced.html"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*"
  ]
}
